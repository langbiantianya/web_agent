		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.10.0",
		"@sveltejs/adapter-node": "^6.0.5",
		"@tailwindcss/vite": "^4.3.5",
