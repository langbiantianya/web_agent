# ---- 数据库 ----
# 生产（MySQL，推荐）
# DATABASE_URL=mysql+asyncmy://user:pass@127.0.0.1:3306/agentdb?charset=utf8mb4
# 备选驱动（纯 Python，无需编译）
# DATABASE_URL=mysql+aiomysql://user:pass@127.0.0.1:3306/agentdb?charset=utf8mb4
# 生产（PostgreSQL，psycopg3）
# DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/agentdb
# 本地开发
DATABASE_URL=sqlite+aiosqlite:///./web_agent.db

# `docker-compose.lab.yml` 从这里读取数据库连接信息；请不要提交真实值。
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=webagent

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false
# PostgreSQL 会话时区。PG 的 now() 返回带时区的时间，落到无时区的 TIMESTAMP 列
# 时按会话时区折算——不钉成 UTC，时间戳会差 8 小时。留空则不下发该参数。
DB_PG_TIMEZONE=UTC

# ---- 安全 ----
# 必改！生成方式：
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=dev-insecure-secret-key-change-me-in-production-0123456789
SSE_TICKET_TTL=60
# 请求体上限（字节），超了直接 413。没有它时一条 5 MB 的 system_prompt 会被
# 完整受理——进内存、落库、送 LLM，成本落在后面那次模型调用上。
MAX_REQUEST_BYTES=2097152

# ---- 事件流 ----
EVENT_BATCH_SIZE=20
EVENT_FLUSH_INTERVAL=0.05
SSE_PING_INTERVAL=15
SSE_REPLAY_GAP_THRESHOLD=500

# ---- 编排 ----
CONTEXT_MAX_TOKENS=6000
CONTEXT_MAX_MESSAGES=50
NODE_MAX_RETRIES=2
NODE_RETRY_BASE_DELAY=0.5

# ---- 工具调用（V3.2）----
# 一次节点执行里「模型→工具→模型」最多来回几轮（模型调用次数上限）。
# 模型在最后一轮还想要工具，就判定它陷住了：run 直接失败，**不重试**
# （重试同一个节点，模型大概率还是同样地陷住，白烧一轮 token）。
TOOL_MAX_ROUNDS=5
# 工具结果回灌给模型时的最大字符数：太长会挤爆下一轮的 prompt
TOOL_RESULT_MAX_CHARS=4000
# 工具调用审计（V4.3）：每次执行独立提交脱敏账本。
TOOL_AUDIT_ENABLED=true
# 管理员回看结果的保存上限；与回灌模型的 TOOL_RESULT_MAX_CHARS 分开。
TOOL_AUDIT_MAX_RESULT_CHARS=65536
# 保留天数与周期清理。单批扫描上限用于保护小内存机器。
TOOL_AUDIT_RETENTION_DAYS=30
TOOL_AUDIT_CLEANUP_ENABLED=true
TOOL_AUDIT_CLEANUP_INTERVAL_SEC=3600
TOOL_AUDIT_CLEANUP_SCAN_LIMIT=1000

# ---- 演示/种子数据用的模型（scripts/seed.py 读取）----
# 以下值只用于 `python -m scripts.seed` 首次创建数据库 `llm_endpoint=default`。
# 运行期以数据库配置为准，之后通过 `/api/llm-endpoints` 管理多个地址与 Key。
# MiniMax（国内）：
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_KEY=

# DeepSeek 换成：
# MINIMAX_BASE_URL=https://api.deepseek.com/v1
# MINIMAX_MODEL=deepseek-chat
# MINIMAX_API_KEY=sk-xxxx

# 其它 ----
APP_NAME=web-agent
DEBUG=false
OPENAI_TIMEOUT=120
RUN_EVENT_RETENTION_DAYS=7

# 实时流空闲多久回查一次 run 状态（兜住重连窗口，见 README 恢复策略）
SSE_IDLE_RECHECK=2.0

# ---- 人工审批（V3.1）----
# 审批暂停点（LangGraph checkpointer）。关掉它普通流程照跑，只是审批节点不可用。
# 开了 Redis 就用 Redis saver（暂停点所有实例共享），否则用本地 SQLite 文件。
# 注意：checkpointer 不可用时服务**直接启动失败**，不静默降级——没有暂停点，
# 流程会卡在审批节点上不动，那种状态比明确报错难查得多。
CHECKPOINT_ENABLED=true
# 仅在 REDIS_ENABLED=false 时用到。必须是**纯文件路径**（不是 sqlite+aiosqlite:// URL）
CHECKPOINT_SQLITE_PATH=./checkpoints.db
CHECKPOINT_CLEANUP_ENABLED=true
CHECKPOINT_CLEANUP_INTERVAL_SEC=300
CHECKPOINT_ORPHAN_RETENTION_SEC=86400
CHECKPOINT_CLEANUP_SCAN_LIMIT=1000
# 全局审批等待时限（秒）；0 表示不超时。节点可用 approvalTimeoutSec 覆盖，
# approvalTimeoutAction 只支持 reject（默认 fail-closed）或 approve。
APPROVAL_TIMEOUT=86400
APPROVAL_TIMEOUT_SCAN_INTERVAL=30

# ---- Redis（V2 多实例，默认关闭）----
# 关：单实例，事件走进程内总线，回放读 MySQL。
# 开：多实例，事件走 Redis Stream（回放源）+ Pub/Sub（实时），可水平扩容。
#     开启后没有降级路径——Redis 连不上服务会直接启动失败（刻意如此：
#     静默退回进程内总线会造成"能跑但跨实例收不到事件"的分裂大脑）。
REDIS_ENABLED=false
REDIS_URL=redis://192.168.1.5:6379/0
# 键与频道前缀，多套环境共用一个 Redis 时靠它隔离
REDIS_KEY_PREFIX=webagent
# 每个 run 的事件 Stream 保留条数上限（近似裁剪）
REDIS_STREAM_MAXLEN=20000
# 归属租约 TTL（秒）。生成方按 TTL/3 续期；到期即视为无主，启动恢复据此回收
REDIS_ACTIVITY_TTL=120
# Redis 订阅轮询间隔（秒）。退订时只置停止标志、让订阅在下一个周期自行退出
REDIS_POLL_INTERVAL=1.0
# 单次 Redis 读写的**超时**（秒）。刻意与建连超时分开：建连超时只管「连不连得上」，
# 连上之后的读**默认没有上限**——对端只要不回包，这条协程就永远挂着。
# 实测踩过：Redis 所在网段抖动时，XADD / PUBLISH 里的一个读把整个生成流程冻住。
REDIS_SOCKET_TIMEOUT=5.0

# ---- 敏感词前置过滤（V3.4）----
# 提示词进 LLM 之前先过一遍模型（字符 n-gram + 逻辑回归，纯 numpy）。
# 总开关，默认开。模型读不出来服务**直接启动失败**，不静默降级——
# 静默放行等于把「安全前置」变成一句空话，那种失败事后最难发现。
# 要关就显式设 false（配置里有记录、启动日志里也有一行，可审计）。
SENSITIVE_ENABLED=true
# 判定阈值。留 0 = 用模型自带的推荐阈值（训练时按「误报率不超过目标」挑的）。
# 显式给值则覆盖：调高更严（漏得多），调低更松（误杀多）。
SENSITIVE_THRESHOLD=0
# 模型文件路径。默认指向仓库里那份（按项目根解析，与工作目录无关）。
# 要用自己训的模型时改成绝对路径——注意**不能留空**，空字符串会被当成
# 「路径为空」而不是「用默认值」，结果是启动时找不到模型。
# SENSITIVE_MODEL_PATH=C:/srv/web_agent/app/core/sensitive_model.npz
# 滑窗参数。0 = 用模型 meta 里记录的值（重训换了窗口推理必须跟着换）。
SENSITIVE_WINDOW=0
SENSITIVE_STRIDE=0
# 单条提示词最多扫描多少字符（超长的只扫前面这段，控住资源占用）
SENSITIVE_MAX_CHARS=4000

# ---- 管理员门禁（V4/V4.4）----
# 环境引导 Key：首次部署创建数据库管理员、应急恢复时使用。
# 日常管理使用 /api/admin-users 创建的独立 Key（数据库只存 HMAC 摘要）。
# 两者都未配置/未认证时，部署级写操作一律拒绝（fail-closed）。
ADMIN_KEY=
# 环境引导身份在审计里的调用方标识
ADMIN_AUTHOR=admin

# ---- MCP（V4，§21）----
# stdio 的**命令白名单前缀**。为空 = 禁止注册 stdio 类型的 MCP 服务器
# （fail-closed）：注册一台 stdio 服务器就是「允许执行某个程序」，
# 默认开着等于没有门。
# 环境变量写法（JSON 数组）：MCP_ALLOWED_COMMAND_PREFIXES='["/usr/bin/","/opt/tools/"]'
MCP_ALLOWED_COMMAND_PREFIXES=[]
# **出网主机白名单**。为空 = 允许任意主机（但私网网段仍然默认拒绝）。
# 生产部署建议配：MCP_ALLOWED_HOSTS='["mcp.example.com"]'
MCP_ALLOWED_HOSTS=[]
# 是否放行私网 / 回环 / 链路本地地址。默认 False —— Streamable HTTP 的 URL
# 来自配置，是 SSRF 面。本机开发连 127.0.0.1 上的 MCP 服务器时才需要开。
MCP_ALLOW_PRIVATE_NETWORKS=false
# 连接空闲多久后主动关闭。stdio 子进程必须回收，否则会攒出一堆僵尸进程。
MCP_IDLE_TIMEOUT_SEC=300
MCP_IDLE_SWEEP_INTERVAL_SEC=30
# 单台服务器的并发调用上限（信号量）。避免把远端打爆。
MCP_MAX_CONCURRENCY=4
# 连接失败时的重试次数（指数退避）
MCP_MAX_RETRIES=3

# ---- 技能（V4，§22）----
# 技能正文进提示词的总字符预算。超出预算的技能**整个不注入**（宁少勿半）。
SKILL_PROMPT_BUDGET=4000
# 一次最多注入几个技能
SKILL_MAX_COUNT=5
# 技能上传（导入 zip / 上传资源）的请求体上限。
# **只对已认证的 operator/admin 生效**——环境引导 Key 与数据库管理员 Key 均可；
# 未认证或权限不足的调用方仍受 MAX_REQUEST_BYTES 约束。
SKILL_UPLOAD_MAX_BYTES=8388608

# ---- studio 脚本执行（V4，§22.8）----
# studio 的 gRPC 地址。**为空 = 未启用脚本执行**：skill_exec 工具根本不注册，
# 配置期直接拒。注意它与「配置了但连不上」是两件事——后者在
# STUDIO_EXEC_REQUIRED 为真时会让服务**启动失败**。
# 生产里填 studio 的服务地址（如 studio:9000）。同一 DNS 名称对应多个后端时，
# 需要确认服务发现返回全部健康地址，避免 gRPC 长连接固定到单个实例。
STUDIO_EXEC_ADDR=
# studio 连不上时是否启动失败。默认 true——studio 是部署的一个组成部分，
# 它挂了说明部署不完整，让问题在部署时暴露，而不是等到用户的一次 run 里才炸。
STUDIO_EXEC_REQUIRED=true
# 单次执行的默认时限（毫秒）
STUDIO_EXEC_TIMEOUT_MS=30000
# 模型能请求的时限**上限**（毫秒）。写死在配置里，模型改不了。
STUDIO_EXEC_MAX_TIMEOUT_MS=60000
# 脚本正文长度上限（字符）
STUDIO_EXEC_MAX_SCRIPT_CHARS=200000
# gRPC 的负载均衡策略。默认 round_robin，在服务发现返回多个后端地址时轮询；
# gRPC 默认的 pick_first 只使用第一个解析结果。
# 排查问题时可临时改成 pick_first。
STUDIO_EXEC_LB_POLICY=round_robin
# studio 的最低版本。默认 1.0.0：fast-only 部署不被 2.0.0 的语义变更卡住。
# 声明了 isolated 的技能另外要求 >= 2.0.0 且 studio 上报 profiles[isolated]。
STUDIO_EXEC_MIN_VERSION=1.0.0
# studio 能力缓存（Health）的 TTL（秒）。0 = 每次都刷新（测试用）。
STUDIO_EXEC_HEALTH_TTL_SEC=30
