# ---- 数据库 ----
# 生产（MySQL，推荐）
# DATABASE_URL=mysql+asyncmy://user:pass@127.0.0.1:3306/agentdb?charset=utf8mb4
# 备选驱动（纯 Python，无需编译）
# DATABASE_URL=mysql+aiomysql://user:pass@127.0.0.1:3306/agentdb?charset=utf8mb4
# 生产（PostgreSQL，psycopg3）
# DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/agentdb
# 本地开发
DATABASE_URL=sqlite+aiosqlite:///./web_agent.db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false
# PostgreSQL 会话时区。PG 的 now() 返回带时区的时间，落到无时区的 TIMESTAMP 列
# 时按会话时区折算——不钉成 UTC，时间戳会差 8 小时。留空则不下发该参数。
DB_PG_TIMEZONE=UTC

# ---- 安全 ----
# 必改！生成方式：
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=dev-insecure-secret-key-change-me-in-production-0123456789
SSE_TICKET_TTL=60

# ---- 事件流 ----
EVENT_BATCH_SIZE=20
EVENT_FLUSH_INTERVAL=0.05
SSE_PING_INTERVAL=15
SSE_REPLAY_GAP_THRESHOLD=500

# ---- 编排 ----
CONTEXT_MAX_TOKENS=6000
CONTEXT_MAX_MESSAGES=50
NODE_MAX_RETRIES=2
NODE_RETRY_BASE_DELAY=0.5

# ---- 工具调用（V3.2）----
# 一次节点执行里「模型→工具→模型」最多来回几轮（模型调用次数上限）。
# 模型在最后一轮还想要工具，就判定它陷住了：run 直接失败，**不重试**
# （重试同一个节点，模型大概率还是同样地陷住，白烧一轮 token）。
TOOL_MAX_ROUNDS=5
# 工具结果回灌给模型时的最大字符数：太长会挤爆下一轮的 prompt
TOOL_RESULT_MAX_CHARS=4000

# ---- 演示/种子数据用的模型（scripts/seed.py 读取）----
# 所有模型统一走 OpenAI 兼容协议，换供应商只改这三个值，不用改代码。
# MiniMax（国内）：
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_KEY=

# DeepSeek 换成：
# MINIMAX_BASE_URL=https://api.deepseek.com/v1
# MINIMAX_MODEL=deepseek-chat
# MINIMAX_API_KEY=sk-xxxx

# 其它 ----
APP_NAME=web-agent
DEBUG=false
OPENAI_TIMEOUT=120
RUN_EVENT_RETENTION_DAYS=7

# 实时流空闲多久回查一次 run 状态（兜住重连窗口，见 README 恢复策略）
SSE_IDLE_RECHECK=2.0

# ---- 人工审批（V3.1）----
# 审批暂停点（LangGraph checkpointer）。关掉它普通流程照跑，只是审批节点不可用。
# 开了 Redis 就用 Redis saver（暂停点所有实例共享），否则用本地 SQLite 文件。
# 注意：checkpointer 不可用时服务**直接启动失败**，不静默降级——没有暂停点，
# 流程会卡在审批节点上不动，那种状态比明确报错难查得多。
CHECKPOINT_ENABLED=true
# 仅在 REDIS_ENABLED=false 时用到。必须是**纯文件路径**（不是 sqlite+aiosqlite:// URL）
CHECKPOINT_SQLITE_PATH=./checkpoints.db
# 审批等待时限（秒）。仅作记录，暂未启用自动超时通过/驳回
APPROVAL_TIMEOUT=86400

# ---- Redis（V2 多实例，默认关闭）----
# 关：单实例，事件走进程内总线，回放读 MySQL。
# 开：多实例，事件走 Redis Stream（回放源）+ Pub/Sub（实时），可水平扩容。
#     开启后没有降级路径——Redis 连不上服务会直接启动失败（刻意如此：
#     静默退回进程内总线会造成"能跑但跨实例收不到事件"的分裂大脑）。
REDIS_ENABLED=false
REDIS_URL=redis://192.168.1.5:6379/0
# 键与频道前缀，多套环境共用一个 Redis 时靠它隔离
REDIS_KEY_PREFIX=webagent
# 每个 run 的事件 Stream 保留条数上限（近似裁剪）
REDIS_STREAM_MAXLEN=20000
# 归属租约 TTL（秒）。生成方按 TTL/3 续期；到期即视为无主，启动恢复据此回收
REDIS_ACTIVITY_TTL=120
# Redis 订阅轮询间隔（秒）。退订时只置停止标志、让订阅在下一个周期自行退出
REDIS_POLL_INTERVAL=1.0

# ---- 敏感词前置过滤（V3.4）----
# 提示词进 LLM 之前先过一遍：**现成的开源中文审核模型**（ONNX，四个 int8 模型）
# + 一层静态规则短语表。不自己训练。
# 总开关，默认开。模型读不出来服务**直接启动失败**，不静默降级——
# 静默放行等于把「安全前置」变成一句空话，那种失败事后最难发现。
# 要关就显式设 false（配置里有记录、启动日志里也有一行，可审计）。
SENSITIVE_ENABLED=true
# 模型目录。里面是四个 int8 ONNX 模型 + 分词器 + manifest，
# 由 `python -m scripts.fetch_sensitive_model` 拉取。默认按项目根解析，
# 与工作目录无关。要换目录改成绝对路径——注意**不能留空**，空字符串会被当成
# 「路径为空」而不是「用默认值」，结果是启动时找不到模型。
# SENSITIVE_MODEL_DIR=C:/srv/web_agent/app/core/sensitive_models
# 各模型的判定阈值，形如 politic=0.56,violence=0.72,porn=0.56,insult=0.60。
# 留空 = 用代码里内置的标定值（app/core/sensitive.py::DEFAULT_THRESHOLDS）。
# 那些值是**联合标定**出来的：在标定集上贪心分配误报预算，最大化召回。
# 换模型或换语料后必须重新标定——`python -m scripts.eval_sensitive` 会打印新阈值。
# 写错会直接报错，不会静默退回默认值。
# SENSITIVE_THRESHOLDS=
# 滑窗参数。0 = 用代码内置的默认值（窗口 128 字，正好等于分词器的截断上限）。
SENSITIVE_WINDOW=0
SENSITIVE_STRIDE=0
# 一条文本最多切多少个窗口。超了会拉大步长把窗口摊开到整段（不截断，避免漏末尾）。
# 窗口数是耗时的唯一线性因子。
SENSITIVE_MAX_WINDOWS=8
# 单条提示词最多扫描多少字符（超长的只扫前面这段，控住资源占用）。
# CPU 上的 int8 推理约 1.5 ms/token，这个值直接决定长请求要多等多久。
SENSITIVE_MAX_CHARS=2000
# 每个 ONNX 会话内部的线程数。四个模型**之间**已经并行跑了，这里再给每个会话
# 多线程就是超订——默认 1，让并行度落在模型之间。
SENSITIVE_NUM_THREADS=1
# 是否按 manifest 里的 sha256 校验模型文件。模型是「安全前置」的一部分，
# 被换掉了却没人知道，比启动慢一秒钟严重得多，所以默认校验。
SENSITIVE_VERIFY_CHECKSUM=true
