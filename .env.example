# ---- 数据库 ----
# 生产（MySQL，推荐）
# DATABASE_URL=mysql+asyncmy://user:pass@127.0.0.1:3306/agentdb?charset=utf8mb4
# 备选驱动（纯 Python，无需编译）
# DATABASE_URL=mysql+aiomysql://user:pass@127.0.0.1:3306/agentdb?charset=utf8mb4
# 本地开发
DATABASE_URL=sqlite+aiosqlite:///./web_agent.db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ---- 安全 ----
# 必改！生成方式：
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=dev-insecure-secret-key-change-me-in-production-0123456789
SSE_TICKET_TTL=60

# ---- 事件流 ----
EVENT_BATCH_SIZE=20
EVENT_FLUSH_INTERVAL=0.05
SSE_PING_INTERVAL=15
SSE_REPLAY_GAP_THRESHOLD=500

# ---- 编排 ----
CONTEXT_MAX_TOKENS=6000
CONTEXT_MAX_MESSAGES=50
NODE_MAX_RETRIES=2
NODE_RETRY_BASE_DELAY=0.5

# ---- 演示/种子数据用的模型（scripts/seed.py 读取）----
# 所有模型统一走 OpenAI 兼容协议，换供应商只改这三个值，不用改代码。
# MiniMax（国内）：
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_KEY=

# DeepSeek 换成：
# MINIMAX_BASE_URL=https://api.deepseek.com/v1
# MINIMAX_MODEL=deepseek-chat
# MINIMAX_API_KEY=sk-xxxx

# 其它 ----
APP_NAME=web-agent
DEBUG=false
OPENAI_TIMEOUT=120
RUN_EVENT_RETENTION_DAYS=7

# 实时流空闲多久回查一次 run 状态（兜住重连窗口，见 README 恢复策略）
SSE_IDLE_RECHECK=2.0

# ---- 人工审批（V3.1）----
# 审批暂停点（LangGraph checkpointer）。关掉它普通流程照跑，只是审批节点不可用。
# 开了 Redis 就用 Redis saver（暂停点所有实例共享），否则用本地 SQLite 文件。
# 注意：checkpointer 不可用时服务**直接启动失败**，不静默降级——没有暂停点，
# 流程会卡在审批节点上不动，那种状态比明确报错难查得多。
CHECKPOINT_ENABLED=true
# 仅在 REDIS_ENABLED=false 时用到。必须是**纯文件路径**（不是 sqlite+aiosqlite:// URL）
CHECKPOINT_SQLITE_PATH=./checkpoints.db
# 审批等待时限（秒）。仅作记录，暂未启用自动超时通过/驳回
APPROVAL_TIMEOUT=86400

# ---- Redis（V2 多实例，默认关闭）----
# 关：单实例，事件走进程内总线，回放读 MySQL。
# 开：多实例，事件走 Redis Stream（回放源）+ Pub/Sub（实时），可水平扩容。
#     开启后没有降级路径——Redis 连不上服务会直接启动失败（刻意如此：
#     静默退回进程内总线会造成"能跑但跨实例收不到事件"的分裂大脑）。
REDIS_ENABLED=false
REDIS_URL=redis://192.168.1.5:6379/0
# 键与频道前缀，多套环境共用一个 Redis 时靠它隔离
REDIS_KEY_PREFIX=webagent
# 每个 run 的事件 Stream 保留条数上限（近似裁剪）
REDIS_STREAM_MAXLEN=20000
# 归属租约 TTL（秒）。生成方按 TTL/3 续期；到期即视为无主，启动恢复据此回收
REDIS_ACTIVITY_TTL=120
# Redis 订阅轮询间隔（秒）。退订时只置停止标志、让订阅在下一个周期自行退出
REDIS_POLL_INTERVAL=1.0
