# syntax=docker/dockerfile:1.7
#
# 全量测试镜像。生产镜像不携带 tests/，本地宿主 Python 版本又可能与
# langgraph-checkpoint-sqlite 的二进制依赖不匹配；该镜像把两者固定到 Python 3.11。
#
# docker build -f Dockerfile.test -t webagent/tests:local .
# docker run --rm --memory=1200m --cpus=1 \
#   -v /var/run/docker.sock:/var/run/docker.sock \
#   -v /tmp:/tmp webagent/tests:local
#
# ``/tmp`` 必须与宿主同路径挂载：测试容器通过宿主 Docker daemon 启动 sibling
# 沙箱时，payload 路径会由 daemon 在宿主文件系统解析。只挂 socket 会让 sibling
# 看不到测试容器里的 /tmp 路径。

FROM node:20.18.1-bookworm-slim AS node

FROM python:3.11.9-slim-bookworm

ARG PIP_INDEX_URL=https://pypi.org/simple

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=UTC

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -i "${PIP_INDEX_URL}" -r requirements.txt "docker>=7"

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/bin/node /usr/local/bin/node

COPY alembic.ini pytest.ini run.py ./
COPY alembic/ ./alembic/
COPY app/ ./app/
COPY proto/ ./proto/
COPY scripts/ ./scripts/
COPY services/ ./services/
COPY tests/ ./tests/
COPY web/ ./web/
COPY webagent/ ./webagent/

CMD ["python", "-m", "pytest", "-q", "-p", "no:langsmith", "--timeout=180"]

