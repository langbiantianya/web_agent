# syntax=docker/dockerfile:1.7
#
# 全量测试镜像。生产镜像不携带 tests/，本地宿主 Python 版本又可能与
# langgraph-checkpoint-sqlite 的二进制依赖不匹配；该镜像把两者固定到 Python 3.11。
#
# docker build -f Dockerfile.test -t webagent/tests:local .
# docker run --rm --memory=1200m --cpus=1 \
#   -v /var/run/docker.sock:/var/run/docker.sock webagent/tests:local

FROM python:3.11.9-slim-bookworm

ARG PIP_INDEX_URL=https://pypi.org/simple

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=UTC

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -i "${PIP_INDEX_URL}" -r requirements.txt "docker>=7"

COPY alembic.ini pytest.ini run.py ./
COPY alembic/ ./alembic/
COPY app/ ./app/
COPY proto/ ./proto/
COPY scripts/ ./scripts/
COPY services/ ./services/
COPY tests/ ./tests/
COPY web/ ./web/
COPY webagent/ ./webagent/

CMD ["python", "-m", "pytest", "-q", "-p", "no:langsmith", "--timeout=180"]

