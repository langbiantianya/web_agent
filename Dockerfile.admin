# Ludic 1.x 要求 Python >= 3.14；admin-web 与其他容器保持独立运行时。
FROM python:3.14-slim-bookworm

ARG PIP_INDEX_URL=https://pypi.org/simple

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=UTC \
    ADMIN_WEB_PORT=8001

WORKDIR /app

COPY requirements.admin.txt ./
RUN pip install -i "${PIP_INDEX_URL}" -r requirements.admin.txt

RUN groupadd --system --gid 10001 webagent \
    && useradd --system --uid 10001 --gid webagent --home-dir /app webagent

COPY app/ ./app/
COPY services/admin_web/ ./services/admin_web/
COPY services/__init__.py ./services/__init__.py
# 迁移在入口里跑（`scripts/admin_entrypoint.py`），所以 alembic 与 scripts 包
# 都必须进镜像——少了任何一个，容器会在启动时才发现。
COPY scripts/__init__.py scripts/admin_healthcheck.py scripts/bootstrap_superadmin.py \
     scripts/admin_entrypoint.py ./scripts/
COPY alembic.ini ./
COPY alembic/ ./alembic/

USER 10001:10001

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["python", "-m", "scripts.admin_healthcheck"]

# 入口先 `alembic upgrade head`，再把进程换成 CMD 里的命令。
# 关掉自动迁移的开关是 `ADMIN_MIGRATE_ON_START=0`。
ENTRYPOINT ["python", "-m", "scripts.admin_entrypoint"]
CMD ["uvicorn", "services.admin_web.app:app", "--host", "0.0.0.0", "--port", "8001"]
